{
  "name": "zhami",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build main.ts --outfile main.js --format cjs --target browser --external obsidian",
    "check": "tsc --noEmit -p .",
    "lint": "eslint main.ts src",
    "dev": "bun run build && cp main.js manifest.json styles.css \"$VAULT/.obsidian/plugins/zhami/\"",
    "test": "TZ=UTC bun test",
    "docs": "TZ=UTC bun scripts/docs.ts",
    "e2e": "bun run build && bun test/e2e/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "moment": "2.31.0",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "moment": "2.31.0",
    "minimatch": "11.0.8"
  }
}
